DB_URL=jdbc:postgresql://localhost:5432/db_project
DB_USER=postgres
DB_PASSWORD=postgres
CORS_ORIGIN=http://localhost:3000

# Wajib: buat dengan `openssl rand -base64 48`
JWT_SECRET=
# Akun admin pertama (password minimal 8 karakter)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_FULL_NAME=Administrator
APP_ADMIN_EMAIL=

# Pendaftaran mandiri + verifikasi email (lihat README sebelum mengaktifkan)
APP_REGISTRATION_ENABLED=false
APP_DEV_LOG_CODES=false
APP_MAIL_FROM=no-reply@contoh.com
